# Bluetooth device name of your watch
# It doesn't have to be an exact match!
# "Smart Band" will work too, if your Bluetooth name is like "Mi Smart Band"
TARGET_NAME_KEY=Smart Band

# Authentication key from Mi Fitness app
# How to get one: https://gadgetbridge.org/basics/pairing/huami-xiaomi-server/
AUTH_KEY=YOUR_AUTH_KEY

# Web overlay server settings
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8765

# How often to poll heart rate data from the watch (in seconds)
POLL_INTERVAL_SECONDS=60

# Initial fetch window when connecting (in minutes)
INITIAL_FETCH_MINUTES=15

# Mark heart rate data as stale after this time (in seconds)
STALE_AFTER_SECONDS=180

# Enable debug logs (true/false)
DEBUG=False

# Disable heart rate color coding (true/false)
DISABLE_COLORS=False
